@page "/tickets"

<PageTitle>Bilety — ReShare</PageTitle>

<div class="ticket-market">

    <section class="ticket-market-header">
        <div class="ticket-market-heading">
            <span class="ticket-market-eyebrow">
                <span></span>
                RESHARE MARKETPLACE
            </span>

            <h1>Znajdź swój następny <span>event.</span></h1>

            <p>
                Odkrywaj wydarzenia, kupuj bilety i nie przegap
                okazji, które naprawdę mają znaczenie.
            </p>
        </div>

        <div class="ticket-market-summary">
            <div class="ticket-market-summary-icon">
                <i class="bi bi-ticket-perforated"></i>
            </div>
            <div>
                <strong>850+</strong>
                <span>aktywnych ofert</span>
            </div>
        </div>
    </section>

    <section class="ticket-market-content">

        <div class="ticket-market-toolbar">
            <div class="ticket-market-title">
                <div>
                    <span class="ticket-market-section-label">MARKETPLACE</span>
                    <h2>Dostępne bilety</h2>
                    <p>Wybierz coś dla siebie spośród dostępnych ofert.</p>
                </div>
            </div>

            <div class="ticket-market-sort">
                <span>Sortuj według</span>
                <select aria-label="Sortowanie ofert">
                    <option>Najnowsze</option>
                    <option>Cena: rosnąco</option>
                    <option>Cena: malejąco</option>
                </select>
            </div>
        </div>

        <div class="ticket-market-categories">
            <button class="ticket-market-category active" type="button">Wszystkie <span>850</span></button>
            <button class="ticket-market-category" type="button">Koncerty</button>
            <button class="ticket-market-category" type="button">Festiwale</button>
            <button class="ticket-market-category" type="button">Sport</button>
            <button class="ticket-market-category" type="button">Inne</button>
        </div>

        <div class="ticket-market-grid">

            <article class="ticket-market-card">
                <div class="ticket-market-image">
                    <img src="https://images.unsplash.com/photo-1459749411175-04bf5292ceea?w=900" alt="Koncert na żywo" />
                    <span class="ticket-market-tag">KONCERT</span>
                    <span class="ticket-market-condition">Dostępny</span>
                </div>

                <div class="ticket-market-card-body">
                    <div class="ticket-market-meta">
                        <span><i class="bi bi-calendar3"></i> 18 grudnia 2026</span>
                        <span><i class="bi bi-geo-alt"></i> Warszawa</span>
                    </div>

                    <h3>The Weeknd — After Hours</h3>
                    <p class="ticket-market-description">PGE Narodowy · Sektor premium</p>

                    <div class="ticket-market-card-footer">
                        <div class="ticket-market-price">
                            <span>Cena biletu</span>
                            <strong>450 <small>PLN</small></strong>
                        </div>
                        <button class="ticket-market-details" type="button">
                            Szczegóły <i class="bi bi-arrow-up-right"></i>
                        </button>
                    </div>
                </div>
            </article>

            <article class="ticket-market-card">
                <div class="ticket-market-image">
                    <img src="https://images.unsplash.com/photo-1470229722913-7c0e2dbbafd3?w=900" alt="Festiwal muzyczny" />
                    <span class="ticket-market-tag">FESTIWAL</span>
                    <span class="ticket-market-condition">Dostępny</span>
                </div>

                <div class="ticket-market-card-body">
                    <div class="ticket-market-meta">
                        <span><i class="bi bi-calendar3"></i> 2 lipca 2027</span>
                        <span><i class="bi bi-geo-alt"></i> Gdynia</span>
                    </div>

                    <h3>Open'er Festival 2027</h3>
                    <p class="ticket-market-description">Lotnisko Gdynia-Kosakowo · 4 dni</p>

                    <div class="ticket-market-card-footer">
                        <div class="ticket-market-price">
                            <span>Cena biletu</span>
                            <strong>690 <small>PLN</small></strong>
                        </div>
                        <button class="ticket-market-details" type="button">
                            Szczegóły <i class="bi bi-arrow-up-right"></i>
                        </button>
                    </div>
                </div>
            </article>

            <article class="ticket-market-card">
                <div class="ticket-market-image">
                    <img src="https://images.unsplash.com/photo-1501386761578-eac5c94b800a?w=900" alt="Koncert muzyczny" />
                    <span class="ticket-market-tag">KONCERT</span>
                    <span class="ticket-market-condition">Dostępny</span>
                </div>

                <div class="ticket-market-card-body">
                    <div class="ticket-market-meta">
                        <span><i class="bi bi-calendar3"></i> 21 listopada 2026</span>
                        <span><i class="bi bi-geo-alt"></i> Kraków</span>
                    </div>

                    <h3>Quebonafide — Tour</h3>
                    <p class="ticket-market-description">TAURON Arena · Płyta</p>

                    <div class="ticket-market-card-footer">
                        <div class="ticket-market-price">
                            <span>Cena biletu</span>
                            <strong>220 <small>PLN</small></strong>
                        </div>
                        <button class="ticket-market-details" type="button">
                            Szczegóły <i class="bi bi-arrow-up-right"></i>
                        </button>
                    </div>
                </div>
            </article>

            <article class="ticket-market-card">
                <div class="ticket-market-image">
                    <img src="https://images.unsplash.com/photo-1506157786151-b8491531f063?w=900" alt="Koncert stadionowy" />
                    <span class="ticket-market-tag">KONCERT</span>
                    <span class="ticket-market-condition">Dostępny</span>
                </div>

                <div class="ticket-market-card-body">
                    <div class="ticket-market-meta">
                        <span><i class="bi bi-calendar3"></i> 12 sierpnia 2027</span>
                        <span><i class="bi bi-geo-alt"></i> Berlin</span>
                    </div>

                    <h3>Taylor Swift — Live</h3>
                    <p class="ticket-market-description">Olympiastadion · Trybuny</p>

                    <div class="ticket-market-card-footer">
                        <div class="ticket-market-price">
                            <span>Cena biletu</span>
                            <strong>520 <small>PLN</small></strong>
                        </div>
                        <button class="ticket-market-details" type="button">
                            Szczegóły <i class="bi bi-arrow-up-right"></i>
                        </button>
                    </div>
                </div>
            </article>

            <article class="ticket-market-card">
                <div class="ticket-market-image">
                    <img src="https://images.unsplash.com/photo-1461896836934-ffe607ba8211?w=900" alt="Wydarzenie sportowe" />
                    <span class="ticket-market-tag">SPORT</span>
                    <span class="ticket-market-condition">Dostępny</span>
                </div>

                <div class="ticket-market-card-body">
                    <div class="ticket-market-meta">
                        <span><i class="bi bi-calendar3"></i> 5 grudnia 2026</span>
                        <span><i class="bi bi-geo-alt"></i> Madryt</span>
                    </div>

                    <h3>Real Madrid — Barcelona</h3>
                    <p class="ticket-market-description">Santiago Bernabéu · Trybuny</p>

                    <div class="ticket-market-card-footer">
                        <div class="ticket-market-price">
                            <span>Cena biletu</span>
                            <strong>380 <small>PLN</small></strong>
                        </div>
                        <button class="ticket-market-details" type="button">
                            Szczegóły <i class="bi bi-arrow-up-right"></i>
                        </button>
                    </div>
                </div>
            </article>

            <article class="ticket-market-card">
                <div class="ticket-market-image">
                    <img src="https://images.unsplash.com/photo-1492684223066-81342ee5ff30?w=900" alt="Festiwal muzyczny" />
                    <span class="ticket-market-tag">FESTIWAL</span>
                    <span class="ticket-market-condition">Dostępny</span>
                </div>

                <div class="ticket-market-card-body">
                    <div class="ticket-market-meta">
                        <span><i class="bi bi-calendar3"></i> 24 lipca 2027</span>
                        <span><i class="bi bi-geo-alt"></i> Kołobrzeg</span>
                    </div>

                    <h3>Sunrise Festival</h3>
                    <p class="ticket-market-description">Podczele · Bilet weekendowy</p>

                    <div class="ticket-market-card-footer">
                        <div class="ticket-market-price">
                            <span>Cena biletu</span>
                            <strong>310 <small>PLN</small></strong>
                        </div>
                        <button class="ticket-market-details" type="button">
                            Szczegóły <i class="bi bi-arrow-up-right"></i>
                        </button>
                    </div>
                </div>
            </article>

        </div>

        <div class="ticket-market-bottom">
            <span>Wyświetlono 6 z 850 ofert</span>
            <div class="ticket-market-pagination">
                <button type="button" disabled><i class="bi bi-chevron-left"></i></button>
                <button type="button" class="active">1</button>
                <button type="button">2</button>
                <button type="button">3</button>
                <span>...</span>
                <button type="button">12</button>
                <button type="button"><i class="bi bi-chevron-right"></i></button>
            </div>
        </div>

    </section>
</div>