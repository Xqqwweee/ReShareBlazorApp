@page "/profile"

<PageTitle>Profil — Reshare</PageTitle>

<div class="profile-page">

    <div class="profile-header">
        <div>
            <span class="profile-eyebrow">TWOJE KONTO</span>
            <h1>Mój profil</h1>
            <p>Zarządzaj swoim profilem i przeglądaj aktywność.</p>
        </div>

        <a href="#" class="profile-edit-button">
            <i class="bi bi-pencil"></i>
            Edytuj profil
        </a>
    </div>

    <section class="profile-main-card">

        <div class="profile-cover">
            <div class="profile-cover-pattern"></div>
            <span class="profile-member-badge">
                <i class="bi bi-patch-check-fill"></i>
                Członek Reshare
            </span>
        </div>

        <div class="profile-identity">

            <div class="profile-avatar">
                KJ
                <span class="profile-avatar-status"></span>
            </div>

            <div class="profile-identity-info">
                <h2>Kamil Jaworski</h2>
                <span class="profile-username">@@jawor0202</span>
                <p>
                    <i class="bi bi-geo-alt"></i>
                    Nowy Sącz, Polska
                    <span class="profile-identity-divider">·</span>
                    <i class="bi bi-calendar3"></i>
                    Dołączył w listopadzie 1996
                </p>
            </div>

            <div class="profile-rating">
                <i class="bi bi-star-fill"></i>
                <strong>4.9</strong>
                <span>12 opinii</span>
            </div>

        </div>

        <div class="profile-bio">
            <span>O MNIE</span>
            <p>
                Miłośnik koncertów i wydarzeń muzycznych.
                Sprzedaję bilety, na które nie mogę już się wybrać.
            </p>
        </div>

    </section>

    <section class="profile-stats">

        <div class="profile-stat">
            <div class="profile-stat-icon">
                <i class="bi bi-ticket-perforated"></i>
            </div>
            <div>
                <strong>8</strong>
                <span>Wystawionych biletów</span>
            </div>
        </div>

        <div class="profile-stat">
            <div class="profile-stat-icon">
                <i class="bi bi-check-circle"></i>
            </div>
            <div>
                <strong>15</strong>
                <span>Zrealizowanych transakcji</span>
            </div>
        </div>

        <div class="profile-stat">
            <div class="profile-stat-icon">
                <i class="bi bi-star"></i>
            </div>
            <div>
                <strong>4.9/5</strong>
                <span>Średnia ocen</span>
            </div>
        </div>

        <div class="profile-stat">
            <div class="profile-stat-icon">
                <i class="bi bi-calendar-check"></i>
            </div>
            <div>
                <strong>2026</strong>
                <span>Rok dołączenia</span>
            </div>
        </div>

    </section>

    <section class="profile-listings">

        <div class="profile-section-header">
            <div>
                <span class="profile-section-eyebrow">MARKETPLACE</span>
                <h2>Moje oferty</h2>
                <p>Bilety, które aktualnie wystawiasz na sprzedaż.</p>
            </div>

            <a href="/tickets" class="profile-view-all">
                Zobacz marketplace
                <i class="bi bi-arrow-up-right"></i>
            </a>
        </div>

        <div class="profile-listings-grid">

            <article class="profile-listing-card">
                <div class="profile-listing-image">
                    <img src="https://images.unsplash.com/photo-1459749411175-04bf5292ceea?w=800"
                         alt="Koncert" />
                    <span>AKTYWNA</span>
                </div>
                <div class="profile-listing-body">
                    <h3>THE WEEKND — After Hours</h3>
                    <div class="profile-listing-meta">
                        <span><i class="bi bi-calendar3"></i> 18.12.2026</span>
                        <span><i class="bi bi-geo-alt"></i> Warszawa</span>
                    </div>
                    <div class="profile-listing-footer">
                        <strong>450 zł</strong>
                        <span><i class="bi bi-eye"></i> 124 wyświetlenia</span>
                    </div>
                </div>
            </article>

            <article class="profile-listing-card">
                <div class="profile-listing-image">
                    <img src="https://images.unsplash.com/photo-1470229722913-7c0e2dbbafd3?w=800"
                         alt="Festiwal" />
                    <span>AKTYWNA</span>
                </div>
                <div class="profile-listing-body">
                    <h3>Open'er Festival 2027</h3>
                    <div class="profile-listing-meta">
                        <span><i class="bi bi-calendar3"></i> 02.07.2027</span>
                        <span><i class="bi bi-geo-alt"></i> Gdynia</span>
                    </div>
                    <div class="profile-listing-footer">
                        <strong>690 zł</strong>
                        <span><i class="bi bi-eye"></i> 86 wyświetleń</span>
                    </div>
                </div>
            </article>

            <article class="profile-listing-card">
                <div class="profile-listing-image">
                    <img src="https://images.unsplash.com/photo-1501386761578-eac5c94b800a?w=800"
                         alt="Koncert" />
                    <span>AKTYWNA</span>
                </div>
                <div class="profile-listing-body">
                    <h3>Quebonafide — Tour</h3>
                    <div class="profile-listing-meta">
                        <span><i class="bi bi-calendar3"></i> 21.11.2026</span>
                        <span><i class="bi bi-geo-alt"></i> Kraków</span>
                    </div>
                    <div class="profile-listing-footer">
                        <strong>220 zł</strong>
                        <span><i class="bi bi-eye"></i> 53 wyświetlenia</span>
                    </div>
                </div>
            </article>

        </div>

    </section>

    <section class="profile-account">

        <div class="profile-section-header">
            <div>
                <span class="profile-section-eyebrow">USTAWIENIA</span>
                <h2>Informacje o koncie</h2>
            </div>
        </div>

        <div class="profile-account-card">

            <div class="profile-account-row">
                <div class="profile-account-icon">
                    <i class="bi bi-envelope"></i>
                </div>
                <div>
                    <small>ADRES E-MAIL</small>
                    <strong>jan.kowalski@example.com</strong>
                </div>
                <span class="profile-verified">
                    <i class="bi bi-check-circle-fill"></i>
                    Zweryfikowany
                </span>
            </div>

            <div class="profile-account-row">
                <div class="profile-account-icon">
                    <i class="bi bi-person"></i>
                </div>
                <div>
                    <small>NAZWA UŻYTKOWNIKA</small>
                    <strong>jankowalski</strong>
                </div>
                <i class="bi bi-chevron-right profile-account-arrow"></i>
            </div>

            <div class="profile-account-row">
                <div class="profile-account-icon">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div>
                    <small>BEZPIECZEŃSTWO</small>
                    <strong>Ustawienia konta i hasła</strong>
                </div>
                <i class="bi bi-chevron-right profile-account-arrow"></i>
            </div>

        </div>

    </section>

</div>  