@page "/login"
@using ReShareBlazorApp.Web.Models
@rendermode InteractiveServer
@inject NavigationManager NavigationManager

<h3>LoginPage</h3>

<EditForm Model="@LoginModel">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="login-card">
        <div class="login-label">
            <label>E-mail</label>
            <InputText @bind-Value="LoginModel.Email" placeholder="Wpisz e-mail!" />
            <ValidationMessage For="() => LoginModel.Email" />
        </div>
        <div class="login-label">
            <label>E-mail</label>
            <InputText @bind-Value="LoginModel.Password" placeholder="Wpisz hasło!" />
            <ValidationMessage For="() => LoginModel.Password" />
        </div>


        <button type="submit" class="login-button">Zaloguj się</button>
    </div>
</EditForm>

<hr />

<button class="register-button" @onclick='() => NavigationManager.NavigateTo("/register")'>
    Utwórz konto
</button>

@code {
    public LoginModel LoginModel { get; set; } = new();

}