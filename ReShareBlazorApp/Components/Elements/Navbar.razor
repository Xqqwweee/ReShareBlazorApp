
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

<nav class="navbar navbar-expand bg-1">
    <div class="container-fluid">

        <a class="navbar-brand" href="/">
    <span>re<span class="brand-accent">share.</span></span>
</a>

        <ul class="nav navbar-nav main-nav">

            <li class="nav-item">
                <a class="nav-link" href="/">
                    <i class="bi bi-house-door"></i>
                    Strona główna
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link" href="/tickets">
                    <i class="bi bi-ticket-perforated"></i>
                    Bilety
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link" href="/messages">
                    <i class="bi bi-chat-dots"></i>
                    Wiadomości
                    <span class="notification-dot"></span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link" href="/profile">
                    <i class="bi bi-person"></i>
                    Profil
                </a>
            </li>

        </ul>

        <div class="navbar-right">

            <form class="search-box" role="search">
                <i class="bi bi-search search-icon"></i>

                <input type="search"
                       placeholder="Szukaj wydarzeń..."
                       aria-label="Szukaj wydarzeń" />

            </form>

            <AuthorizeView>
                <Authorized Context="auth">

                    <div class="navbar-auth">

                        <div class="navbar-user">
                            <i class="bi bi-person-circle"></i>
                            <span>
                                @(auth.User.FindFirst(ClaimTypes.Email)?.Value
                                    ?? auth.User.FindFirst("email")?.Value
                                    ?? "Użytkownik")
                            </span>
                        </div>

                        <form method="post" action="/auth/logout">
                            <AntiforgeryToken />

                            <button type="submit" class="navbar-logout">
                                <i class="bi bi-box-arrow-right"></i>
                                Wyloguj się
                            </button>
                        </form>

                    </div>

                </Authorized>

                <NotAuthorized>

                    <div class="navbar-auth">
                        <a href="/login" class="navbar-login">
                            Zaloguj się
                        </a>

                        <a href="/register" class="navbar-register">
                            Zarejestruj się
                        </a>
                    </div>

                </NotAuthorized>
            </AuthorizeView>

        </div>

    </div>
</nav>
